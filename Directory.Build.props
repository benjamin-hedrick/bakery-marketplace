<Project>

  <!-- Roslyn analyzers on for every project (WI-PORT-003 follow-up, 2026-10-28). The service and library projects build with no warnings; the test
       projects of tools/ still report some, so warnings are not errors yet. Turn TreatWarningsAsErrors on when those are cleared, and add stricter
       rules one at a time in .editorconfig. -->
  <PropertyGroup>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

</Project>
