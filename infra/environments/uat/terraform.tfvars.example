# Copy to uat.tfvars (git-ignored) or pass as pipeline variables. None of these is a secret. The values UAT fixes (its name, group, host
# environment, Cosmos tier and region) are in main.tf; the descriptions and checks of every setting are in infra/modules/environment/variables.tf.
# The vault and Cosmos names are globally unique and must differ from dev's.
tenant_id                 = "00000000-0000-0000-0000-000000000000"
registry_login_server     = "bakerymkt123.azurecr.io"
app_identity_id           = "/subscriptions/.../resourceGroups/rg-bakery-foundation/providers/Microsoft.ManagedIdentity/userAssignedIdentities/id-bakery-uat-apps"
app_identity_principal_id = "00000000-0000-0000-0000-000000000000"
deploy_principal_id       = "00000000-0000-0000-0000-000000000000"
key_vault_name            = "kv-bakery-uat-abc12"
cosmos_account_name       = "cosmos-bakery-uat-abc12"

# The issuer is a run input of the UAT pipeline (mockIssuer), not a value kept here.
# To restrict the environment to your address:
# allowed_ips = ["203.0.113.7/32"]
# To also allow Admin or Vendor logins (requires allowed_ips): issuer_roles = ["Customer", "Admin"]

# The .NET services run as Production in UAT: set in main.tf (host_environment), not here. UAT never runs a chaos scenario.
