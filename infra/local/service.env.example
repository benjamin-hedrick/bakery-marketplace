# Environment for application services run on the host against docker-compose.yml (docs/operations/local-dev.md).
# Copy the lines you need into your shell or launch settings. ASP.NET Core maps "__" to ":" in configuration keys.
# No real secrets here: local development only.

# Shared by every service
Auth__Authority=http://localhost:5100
Auth__Audience=bakery-marketplace

# catalog-service
Events__Backend=redis
Redis__ConnectionString=localhost:6379
Data__Backend=cosmos
Cosmos__Database=bakery
# The AccountKey below is the Cosmos emulator's publicly documented fixed key. It is not a secret and only works
# against the local emulator.
Cosmos__ConnectionString=AccountEndpoint=http://localhost:8081/;AccountKey=C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw==
# Already enabled by catalog-service's appsettings.Development.json; set explicitly for other environments:
# Cosmos__GatewayMode=true
# Cosmos__EnsureCreated=true

# Cache (only when started with --profile with-redis)
# CACHE_BACKEND=redis
# REDIS_CONNECTION_STRING=localhost:6380
