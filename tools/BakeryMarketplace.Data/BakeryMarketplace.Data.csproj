<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- 3.63.x is required by the vNext Linux emulator: 3.38.1 and 3.50.0 throw while decoding whole-document query results. -->
    <PackageReference Include="Microsoft.Azure.Cosmos" Version="3.63.2" />
    <!-- Newer Cosmos SDKs require Newtonsoft.Json to be referenced explicitly. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
